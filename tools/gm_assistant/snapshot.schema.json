  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "data",
        "source_ids",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "empty",
            "unavailable",
            "error",
            "not_requested"
          ]
        },
        "data": {},
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "error",
                  "not_requested"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "empty"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "const": []
              }
            }
          }
        }
      ]
    }
